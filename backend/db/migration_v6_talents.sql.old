-- Migration: WFRP 4e Talents
INSERT INTO talents (name, description, max_rank, tests, source)
VALUES ( 'Aptekarz', 'Jesteś świetnym aptekarzem i lepiej od innych wyrabiasz pigułki, maści, smarowidła, olejki, kremy i im podobne. Możesz odwrócić kolejność kości nieudanego Testu Rzemiosła (Aptekarstwa), jeśli nowy wynik pozwoli ci odnieść sukces.', 'Bonus z Inteligencji', 'Rzemiosło (Aptekarstwo)', 'WFRP4e Core' )
, ( 'Arcydzieło', 'Jesteś niekwestionowanym mistrzem w swojej dziedzinie, tworzącym dzieła tak złożone, że inni mogą je tylko podziwiać, zachwycając się twoim geniuszem. Za każdym razem, gdy wykupujesz ten Talent, tworzysz niezwykłe dzieło, wykorzystując Umiejętność Sztuka lub Rzemiosło. Nie ma ono sobie równych, będzie po wieki inspirowało, zadziwiało i budziło zachwyt swoją wyjątkowością. MG określa premie, które ci przysługują z tej racji. Zwykle wpływają one na Testy Ogłady w kontaktach z tymi, którzy podziwiają twoją sztukę. Sprzedaż dzieła powinna dać ci przynajmniej dziesięciokrotną wartość zwykłej ceny, a czasami nawet więcej.', 'brak', NULL, 'WFRP4e Core' )
, ( 'Artylerzysta', 'Z łatwością przeładowujesz broń prochową. Dodaj PS równe liczbie wykupień tego Talentu do każdego Wydłużonego Testu związanego z przeładowaniem broni prochowej.', 'Bonus ze Zręczności', NULL, 'WFRP4e Core' )
, ( 'Atak Wyprzedzający', 'Twoje błyskawiczne ciosy pozwalają na powalenie przeciwników, zanim oni sami zdążą zaatakować. Kiedy wróg na ciebie Szarżuje, wykonaj udany Wymagający (+0) Test Inicjatywy, by natychmiast wykonać Darmowy Atak poza normalną kolejnością Rundy. Używasz broni, którą trzymasz w wiodącej ręce. Możesz wykonać tyle Ataków Wyprzedzających w Rundzie, ile razy wykupiłeś ten Talent, ale tylko raz na każdego szarżującego.', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Atrakcyjny', 'Może to przenikliwe spojrzenie lub zgrabna sylwetka, a może to, jak w uśmiechu odsłaniasz biel swoich zębów. Wiesz, jak najlepiej pokazać to, czym obdarzyli cię bogowie. Jeżeli uda ci się Test Charyzmy wobec osób, którym się podobasz, możesz obliczyć PS normalnie albo uzyskać ich tyle, ile wypadło na kostce jedności. Na przykład udany Test przy wyrzuceniu 38 oznaczałby wtedy 8 PS.', 'Bonus z Ogłady', 'Charyzma, by wpłynąć na tych, którym się podobasz', 'WFRP4e Core' )
, ( 'Bardzo Silny', 'Twoja początkowa Siła zostaje na stałe podniesiona o +5, co nie liczy się do sumy twoich Rozwinięć.', '1', NULL, 'WFRP4e Core' )
, ( 'Bardzo Szybki', 'Twoja Szybkość zwiększa się o +1.', '1', NULL, 'WFRP4e Core' )
, ( 'Berserkerska Szarża', 'Nie licząc się z niebezpieczeństwem, rzucasz się na przeciwników, by pędem i siłą zadawać mocniejsze ciosy. Kiedy Szarżujesz, zadajesz +1 punkt obrażeń we wszystkich atakach Walki Wręcz za każde wykupienie tego Talentu.', 'Bonus z Siły', 'Broń Biała w Rundzie, w której Szarżowałeś', 'WFRP4e Core' )
, ( 'Biczownik', 'Swój ból ofiarowałeś wyznawanemu bogu. Każdego dnia musisz spędzić pół dzwonu (pół godziny) na modlitwie, otrzymując obrażenia na poziomie liczby wykupień tego Talentu. Jeśli posiadasz Talent Szał Bojowy, możesz go aktywować po modlitwie.', 'Bonus z Wytrzymałości', 'Opieranie się Niszczycielskim Potęgom', 'WFRP4e Core' )
, ( 'Bitewny Refleks', 'Reagujesz szybko jak błyskawica, dlatego za każde wykupienie tego Talentu otrzymujesz +10 do Inicjatywy, gdy określana jest kolejność Inicjatywy.', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Błękitna Krew', 'Albo urodziłeś się w rodzinie szlacheckiej, albo zostałeś wywyższony już podczas gry. Jeśli jesteś odpowiednio ubrany, inni zawsze traktują cię jak kogoś ze sfer wyższych niż ich, chyba że ktoś z nich także posiada ten Talent. Wtedy normalnie porównuje się Status.', '1', 'Wszystkie Testy, na które wpływa twój Status', 'WFRP4e Core' )
, ( 'Błogosławieństwo (Boska Tradycja)', 'Któryś z bogów czuwa nad tobą i odpowiada na twoje proste modlitwy. Możesz wykorzystywać błogosławieństwa swojego pana, co opisano w Rozdziale 7: Religie i wierzenia. Normalnie możesz znać tylko jedną boską tradycję na Talent Błogosławieństwo.', '1', NULL, 'WFRP4e Core' )
, ( 'Błyskawiczny Strzał', 'Jeśli posiadasz naładowaną broń dystansową, możesz z niej wystrzelić poza Kolejnością Inicjatywy, zanim zareaguje którykolwiek z uczestników walki. Rzut na trafienie wykonaj z uwzględnieniem wszystkich modyfikatorów. Użycie tego Talentu wymaga poświęcenia zarówno Akcji, jak i Ruchu z nadchodzącej Tury i kiedy nadejdzie twoja kolej, będą one traktowane jako wykorzystane. Jeśli ten Talent chcą wykorzystać dwie lub więcej postaci, pierwsza strzela ta, która wykupiła go więcej razy. Jeśli i na tym polu mamy remis, obydwie postacie strzelają równocześnie i wynik ich ataków powinien być rozliczony jednocześnie.', 'Bonus ze Zwinności', 'Broń Zasięgowa, gdy wykorzystujesz Talent Błyskawiczny Strzał', 'WFRP4e Core' )
, ( 'Błyskotliwość', 'Twoja początkowa Inteligencja zostaje na stałe podniesiona o +5, co nie liczy się do sumy twoich Rozwinięć.', '1', NULL, 'WFRP4e Core' )
, ( 'Cios Mierzony', 'Czy w walce wręcz, czy strzelając, umiesz trafiać tam, gdzie najbardziej zaboli. Możesz zmodyfikować Miejsce Trafienia +/-10 za każde wykupienie tego Talentu. Na przykład, jeśli kupiłeś go dwa razy, a wynik 34 wskazuje na prawe ramię, to możesz zmniejszyć go do 14 i trafić w lewe ramię lub zwiększyć do 54 i ugodzić w korpus (patrz strona 158).', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Cios Poniżej Pasa', 'Nauczyłeś się brudnych sztuczek, stosowanych podczas walki bez broni. Zadajesz +1 punkt obrażeń za każde wykupienie tego Talentu, gdy trafisz przeciwnika, używając Umiejętności Broń Biała (Bijatyka). Uwaga: wykorzystanie tego Talentu w pojedynku bokserskim jest uważane za oszustwo.', 'Bonus z Walki Wręcz', 'Broń Biała (Bijatyka)', 'WFRP4e Core' )
, ( 'Czarownica!', 'Nauczyłeś się rzucać czary, wykorzystując surowy Wiatr Magii lub modląc się do zakazanych bóstw, co czyni cię ściganym przez prawo czarownikiem lub heretykiem. Po zakupie tego Talentu możesz nauczyć się czarów z Tradycji Czarownictwa.', '1', NULL, 'WFRP4e Core' )
, ( 'Człowiek Guma', 'Jesteś w stanie wyginać swoje ciało i manipulować nim na sposoby, które zdają się przeczyć naturze. Dzięki temu możesz przeciskać się przez niewielkie otwory lub zmuszać kończyny do nieprawdopodobnych rzeczy. Granice tego wyznacza MG i udany Test Zwinności.', 'Bonus ze Zwinności', 'Kuglarstwo lub Testy Zwinności w sytuacji, gdy przydaje się gibkość', 'WFRP4e Core' )
, ( 'Czujny', 'Swoją początkową Inicjatywę zwiększasz na stałe o +5, co nie liczy się do sumy Rozwinięć twojej postaci.', '1', NULL, 'WFRP4e Core' ), ( 'Czysta Dusza', 'Twoja dusza jest nieskalana i odporna na zakusy Chaosu. Zanim będziesz musiał wykonać Test poddania się Zepsuciu, możesz przyjąć dodatkowe jego Punkty w liczbie równej liczbie wykupień tego Talentu.', 'Bonus z Siły Woli', NULL, 'WFRP4e Core' ), ( 'Czytanie z Ruchu Warg', 'Patrząc na usta innych, potrafisz dowiedzieć się, co mówią. Jeśli możesz bez przeszkód obserwować dolną część twarzy istoty, wolno ci wykonać Test Percepcji, by zrozumieć, co mówi.', 'Bonus z Inicjatywy', 'Testy Percepcji związane z wykorzystaniem tego Talentu', 'WFRP4e Core' )
, ( 'Czytanie/Pisanie', 'Jesteś jednym z nielicznych piśmiennych Staroświatowców. Potrafisz czytać i pisać (o ile to możliwe) w każdym języku, którym umiesz się posługiwać.', '1', NULL, 'WFRP4e Core' );

INSERT INTO talents (name, description, max_rank, tests, source)
VALUES ( 'Charyzmatyczny', 'Twoja początkowa Ogłada zwiększa się na stałe o +5 (co nie wlicza się do sumy Rozwinięć postaci).', '1', NULL, 'WFRP4e Core' )
, ( 'Chirurgia', 'Lata nauki trudnego rzemiosła chirurga pozwalają ci dokonywać cudu operacji, zabiegu niezbędnego przy leczeniu najgroźniejszych obrażeń. W opisie wybranych Trafień Krytycznych znajdziecie informację, że wymagają one interwencji chirurga. Właśnie ty jesteś w stanie im zaradzić. Operacja to Wydłużony Wymagający (+0) Test Leczenia. Liczba wymaganych PS jest ustalana przez MG, ale zwykle to 5-10\. Podczas procedury zadajesz pacjentowi 1k10 obrażeń i nakładasz na niego Stan Krwawienie za każdym razem, gdy wykonujesz Test. To oznacza, że chory może umrzeć, a szansa na to jest wysoka. Po operacji pacjent musi wykonać Przeciętny (+20) Test Odporności, a jego niepowodzenie oznacza drobną infekcję (patrz strona 187).', 'Premia z Inteligencji', 'Leczenie poza walką, czyli kiedy możesz właściwie zająć się rannym', 'WFRP4e Core' )
, ( 'Chodu!', 'W razie niebezpieczeństwa potrafisz przebierać nogami szybciej niż zwykle. Kiedy Uciekasz lub uczestniczysz w pościgu jako ścigany, twoja Szybkość zwiększa się o +1.', 'Bonus ze Zwinności', 'Atletyka, gdy Uciekasz albo kiedy jesteś ściganym podczas pościgu', 'WFRP4e Core' ), ( 'Defraudant', 'Potrafisz podprowadzać pieniądze swoich pryncypałów tak, by tego nie odkryli. Kiedy pozyskujesz dochód podczas zarabiania (w trakcie gry lub oddając się Zajęciu Dochód), możesz wykonać Przeciwstawny Test Inteligencji przeciwko swojemu pracodawcy (jeśli masz takowego). Jeżeli wygrasz, niepostrzeżenie podprowadzasz 2k10 + PS miedzianych pensów, 1k10 + PS srebrnych szylingów lub 1 + PS złotych koron (w zależności od wysokości obrotów, co jest w gestii MG). Jeśli twój pracodawca wygra o +6 PS, zgarniasz pieniądze, ale zostajesz nakryty. Konsekwencje zależą od MG. Inne wyniki oznaczają, że nie udało ci się zrobić defraudacji i nie ukradłeś żadnych pieniędzy.', 'Bonus z Inteligencji', 'Inteligencja (Defraudacja)', 'WFRP4e Core' )
, ( 'Dobrze Przygotowany', 'Dobrze przewidujesz, czego będą potrzebować inni i co przyda się tobie. Tyle razy na sesję, ile razy wykupiłeś ten Talent, możesz wyciągnąć z plecaka lub sakwy niezbędny przedmiot, jeśli jego ciężar w punktach obciążenia wynosi 0, mógł zostać niedawno kupiony i jego posiadanie nie jest czymś niezwykłym. Może to być butelka spirytusu, potrzebna do polania rany kompana, lub gwizdek, którego zabrakło występującemu cyrkowcowi. Kiedy użyjesz tego Talentu, odlicz pieniądze za przedmiot, pokazując tym, że wcześniej go kupiłeś.', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Dostrojony do (Wiatr Magii)', 'Masz silne powiązanie z jednym z Wiatrów Magii. Dodaj PS równe liczbie wykupień tego Talentu do udanego Testu Splatania Magii dla tego Wiatru Magii.', 'Bonus z Siły Woli', 'Splatanie Magii (wybrany Wiatr)', 'WFRP4e Core' )
, ( 'Doświadczony Wędrowiec (Wybrany Teren)', 'Masz doświadczenie w wędrówce przez dzicz i potrafisz dobrze wybierać drogę. Nie działają na ciebie negatywne modyfikatory wynikające z wpływu wybranego terenu. Oto lista przykładów: Lasy, Pustynie, Moczary, Teren Kamienisty, Tundra, Wybrzeża.', 'Bonus ze Zwinności', 'Atletyki podczas podróży w terenie', 'WFRP4e Core' )
, ( 'Dwie Bronie', 'Kiedy jesteś uzbrojony w dwie bronie, podczas swojej Akcji możesz zaatakować obydwiema naraz. Najpierw wykonaj Test trafienia dla broni, którą trzymasz w wiodącej ręce, a jeśli trafisz, określ normalnie obrażenia. Zostaw kości 1k100 na stole, przydadzą się za chwilę. Skoro pierwszy atak się udał i zostały zadane obrażenia, możesz użyć drugiej broni, by uderzyć jeszcze raz. Wykorzystujesz wynik pierwszego rzutu, ale odwracasz kolejność kostek. I tak rzut na trafienie 34 stanie się 43\. Pamiętaj, by obniżyć go o modyfikator wynikający z walki słabszą ręką (-20, chyba że posiadasz Talent Oburęczność). Drugi atak też jest Testem Przeciwstawnym. Twój przeciwnik wykonuje Test obrony, na nowo określane są obrażenia. Wyjątkiem jest sytuacja, gdy pierwszy atak zakończył się Trafieniem Krytycznym. Jeśli tak się stanie, wykorzystaj wynik rzutu w Tabeli Trafień Krytycznych do określenia, czy drugi atak trafił, czy nie. Na przykład, jeśli pierwszy atak trafił przeciwnika krytycznie w głowę, a wynik rzutu w Tabeli Trafień Krytycznych to 56 (Poważna rana oka), to korzystasz z tego rezultatu jako wyniku rzutu na trafienie w drugim ataku. Jeśli atakujesz obydwiema broniami, twoje rzuty na obronę obarczone są modyfikatorem -10 do końca twojej następnej Tury. Nie zyskujesz Przewagi za trafienie lub zranienie przeciwnika, jeśli korzystasz z tego Talentu, chyba że trafisz obydwoma atakami.', 'Bonus ze Zwinności', 'Broń Biała lub Zasięgowa, kiedy atakujesz dwoma sztukami oręża', 'WFRP4e Core' )
, ( 'Etykieta (Grupa Społeczna)', 'Dopóki jesteś odpowiednio ubrany i zachowujesz się należycie, potrafisz wtopić się w tłum wybranej grupy społecznej. Oto przykłady kilku z nich: Członkowie Gildii lub Cechu, Kultyści, Przestępcy, Służba, Szlachta, Uczeni, Żołnierze. Jeśli nie posiadasz tego Talentu, ci, którzy go mają, łatwo zauważą, że nie pasujesz do obcego środowiska. Widać to w zachowaniu bohatera. To oczywiście zależy od odgrywania, ale MG może wprowadzić tu odpowiedni modyfikator do Testów Ogłady.', 'Bonus z Ogłady', 'Charyzma lub Plotkowanie (Grupa Społeczna)', 'WFRP4e Core' )
, ( 'Finta', 'Pilnie ćwiczyłeś pozorowane ataki w zwarciu, by zmylić przeciwnika. W ramach swojej Akcji możesz wykonać fintę przeciwko uzbrojonemu przeciwnikowi. O jej powodzeniu rozstrzyga Przeciwstawny Test Broni Białej (Szermiercza) przeciw Broni Białej wroga. Jeśli go wygrasz i przed końcem następnej rundy zaatakujesz tego samego przeciwnika, możesz dodać PS z finty do swojego Testu ataku.', 'Bonus z Walki Wręcz', 'Broń Biała (Szermiercza) podczas Finty', 'WFRP4e Core' ), ( 'Gadanina', 'W Nordlandzie mówi się, że otwierasz usta, a kiszki przez ciebie przemawiają, w Ostlandzie zaś, że pleciesz bzdury. Gadanina to wylewanie strumienia słów lub niepotrzebne i kwieciste rozwodzenie się nad sprawami trywialnymi lub wręcz pozbawionymi sensu, by wprowadzić rozmówcę w zdumienie i zakłopotanie. Do Gadaniny wykorzystujesz Umiejętność Charyzma w Teście Przeciwstawnym z Inteligencją. Sukces oznacza, że twój rozmówca znajduje się w Stanie Oszołomienie. Każdy poziom Gadaniny sprawia, że cel otrzymuje Stan kolejny raz. Taka osoba bądź istota stoi oniemiała, próbując zrozumieć, o czym mówisz i czego chcesz. Kiedy zagadany osobnik otrząśnie się z oszołomienia i zrozumie, co się działo, może nie być szczęśliwy z tego, jak go zmieszałeś. Ostatecznie zawracałeś mu głowę głupotami. Kiedy przestaniesz nawijać, cel natychmiast otrząśnie się ze Stanu Oszołomienie spowodowanego Gadaniną. Tego Talentu możesz używać tylko raz na danej osobie podczas jednej sceny (a nawet jeszcze rzadziej, jeśli MG tak uzna). Może zdarzyć się tak, że ten sam człowiek drugi raz na twoje paplanie nie da się już nabrać.', 'Bonus z Ogłady', 'Charyzma, by kogoś zagadać', 'WFRP4e Core' )
, ( 'Geniusz Arytmetyczny', 'Masz dar do cyferek i z łatwością potrafisz rozwiązywać problemy matematyczne. Na sesji wolno używać ci kalkulatora, by pokazać geniusz swojej postaci (chyba że go nie potrzebujesz i liczysz w pamięci).', 'Bonus z Inteligencji', 'Wycena, Hazard', 'WFRP4e Core' )
, ( 'Gładkie Słówka', 'Jak Ranald Podstępny, potrafisz tak przeplatać prawdę z kłamstwem, że nie można odróżnić jednego od drugiego. Gdy wykorzystujesz Charyzmę do kłamania, twoi rozmówcy nie mogą wykonywać Przeciwstawnego Testu Intuicji, by sprawdzić, czy przypadkiem ich nie okłamujesz.', 'Bonus z Ogłady', 'Charyzma podczas kłamania', 'WFRP4e Core' )
, ( 'Groźny', 'Twoja postura i wygląd budzą obawę. Kiedy wykonujesz Test Zastraszania, uzyskujesz dodatkowe PS równe liczbie wykupień tego Talentu.', 'Bonus z Siły', 'Zastraszanie', 'WFRP4e Core' );

INSERT INTO talents (name, description, max_rank, tests, source) VALUES ( 'Hulaka', 'Wiesz, jak pić i jak dobrze się bawić. Możesz zamienić kostki nieudanego Testu Mocnej Głowy, jeśli nowy wynik będzie sukcesem.', 'Bonus z Wytrzymałości', 'Charyzma i Plotkowanie podczas przyjęć, Mocna Głowa', 'WFRP4e Core' )
, ( 'Inspirujący', 'Twoje słowa i zachęty mogą przechylić szalę zwycięstwa w bitwie. Poniższa tabela pokazuje, ile osób ulegnie wpływowi Dowodzenia (patrz strona 120) podczas wojny.', 'Bonus z Ogłady', 'Dowodzenie podczas wojny', 'WFRP4e Core' )
, ( 'Intrygant', 'Jesteś mistrzem intryg i za każdym rogiem węszysz spiski. Raz na sesję możesz zadać MG pytanie o sytuację polityczną i zagmatwaną sieć powiązań, a on wykona w tajemnicy Test Inteligencji i przekaże ci pewną ilość informacji, zależną od liczby PS uzyskanych dzięki rzutowi.', 'Bonus z Inteligencji', 'Inteligencji dotyczące tego Talentu', 'WFRP4e Core' )
, ( 'Inwokacja (Boska Tradycja)', 'Zostałeś pobłogosławiony przez swego boskiego patrona, dzięki czemu zyskujesz zdolność czynienia jednego z jego Cudów. Możesz wykupywać kolejne cuda za 100 PD pomnożone przez liczbę obecnie znanych cudów. Pełne zasady tego, jak się ich uczysz, znajdują się w Rozdziale 7: Religie i wierzenia. W normalnych okolicznościach nie możesz wykupić tego Talentu więcej niż jeden raz. Co więcej, nie możesz też kupić Talentów Magia Prosta i Magia Tajemna, jeśli posiadasz Talent Inwokacja. Po wydaniu 100 PD możesz się pozbyć tego Talentu, ale natychmiast utracisz dostęp do wszystkich zapewnianych przez niego cudów. Narażasz się też na gniew swego boga, a MG obmyśli, jak będzie się on przejawiał.', '1', NULL, 'WFRP4e Core' )
, ( 'Krasomówstwo', 'Wiesz, jak porwać tłum. Kiedy wykonujesz Test Charyzmy podczas przemawiania do tłumu, otrzymujesz premię w wysokości tylu PS, ile razy wykupiłeś ten Talent.', 'Bonus z Ogłady', NULL, 'WFRP4e Core' )
, ( 'Krzepki', 'Jesteś twardy jak skała i rany nie robią na tobie wrażenia. Zmniejszasz otrzymywane obrażenia o 1 za każde wykupienie tego Talentu. Zasada ta działa nawet wtedy, gdy nie mógłbyś pomniejszyć otrzymanych ran. Nie możesz w ten sposób zredukować obrażeń poniżej 1 punktu.', 'Bonus z Wytrzymałości', NULL, 'WFRP4e Core' )
, ( 'Łapówkarz', 'Wiesz, jak dawać w łapę. MG powinien obniżyć podstawę wyliczenia łapówki o 10% za każde wykupienie tego Talentu. Minimalna wartość łapówki nie może spaść poniżej 10% wyjściowej stawki.', 'Bonus z Ogłady', 'Łapówkarstwo', 'WFRP4e Core' )
, ( 'Mag Bitewny', 'Zostałeś wyszkolony w rzucaniu czarów podczas bitwy. W swojej Turze możesz rzucić jeden czar o Poziomie Zaklęcia 5 lub niższym w Akcji Darmowej (Test wykonujesz normalnie). Nie używasz zatem pełnej Akcji i możesz ją wykorzystać w dowolny sposób. Jednak w tej Turze nie możesz już rzucić kolejnego czaru.', '1', NULL, 'WFRP4e Core' )
, ( 'Magia Prosta', 'Zawsze miałeś smykałkę do rzucania czarów i opanowałeś metody ich podstawowej kontroli. Kiedy wykupujesz ten Talent, uczysz się i zapamiętujesz tyle czarów, ile wynosi modyfikator z twojej Siły Woli. Kolejnych czarów możesz się nauczyć, korzystając z poniższej tabeli kosztów:', '1', NULL, 'WFRP4e Core' )
, ( 'Magia Tajemna (Tradycja)', 'Studiowałeś jedną z ośmiu tradycji magii: Cienia, Metalu, Niebios, Ognia, Śmierci, Światła, Zwierząt lub Życia albo praktykujesz którąś z mniej znanych: Guślarstwa czy Nekromancji. Możesz zapamiętywać czary ze swojej wybranej tradycji, płacąc za nie podany niżej koszt w Punktach Doświadczenia:', '1', NULL, 'WFRP4e Core' )
, ( 'Majętny', 'Jesteś bajecznie bogaty i rzadko kiedy brakuje ci pieniędzy. Kiedy zarabiasz (włączając w to Zajęcie Dochód), zarabiasz +1 złotą koronę więcej za każdy poziom tego Talentu.', 'brak', NULL, 'WFRP4e Core' )
, ( 'Mały', 'Jesteś niższy od większości mieszkańców Starego Świata. Zasady dotyczące rozmiaru znajdują się na stronie 320 w Rozdziale 12: Bestiariusz.', '1', NULL, 'WFRP4e Core' )
, ( 'Mistrz Charakteryzacji', 'Jesteś ekspertem, jeśli chodzi o przejmowanie manieryzmów i upodobnianie się do kogoś. Zmieniając postawę, wykrzywiając twarz i dobierając ubranie, przestajesz przypominać siebie, nawet jeśli nie masz pod ręką zestawu do charakteryzacji.', 'Bonus z Ogłady', 'Występy (Aktorstwo), gdy udajesz kogoś innego', 'WFRP4e Core' )
, ( 'Mistrz Rzemiosła (Rzemiosło)', 'Jesteś wybitnie wykwalifikowany w danym rzemiośle. Możesz zmniejszyć liczbę wymaganych PS podczas Testu Wydłużonego tego Rzemiosła o tyle, ile razy wykupiłeś ten Talent.', 'Bonus ze Zręczności', 'Pasujący Wydłużony Test tego Rzemiosła', 'WFRP4e Core' )
, ( 'Mistrz Walki', 'Lata nagromadzonego doświadczenia pozwalają ci trzymać przeciwników w szachu. Każde wykupienie tego Talentu sprawia, że gdy określana jest przewaga liczebna w walce, ty liczysz się jak jedna osoba więcej (dwie przy pierwszym wykupieniu, trzy przy drugim itd.). Talent ten działa tylko wtedy, gdy przeciwników jest faktycznie więcej od grupy, w której znajduje się postać. Na stronie 162 znajdują się zasady mówiące o tym, jak stosować przewagę liczebną.', 'Bonus ze Zwinności', NULL, 'WFRP4e Core' )
, ( 'Mocne Plecy', 'Twój kark jest twardy od ciężkiej harówki. Możesz dodać liczbę wykupień tego Talentu do PS Przeciwstawnych Testów Siły i nieść dodatkowy ekwipunek o wadze równej liczbie wykupień tego Talentu w punktach Obciążenia (patrz strona 293).', 'Bonus z Siły', 'Wiosłowanie lub Pływanie', 'WFRP4e Core' )
, ( 'Morderczy Atak', 'Wiesz dobrze, gdzie uderzyć, by wyrządzić jak najwięcej krzywdy. Kiedy zadasz Ranę Krytyczną, zwiększasz też obrażenia o tyle, ile razy wykupiłeś ten Talent.', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Mól Książkowy', 'W bibliotece czujesz się tak naturalnie, jak żeglarz na morzu czy rolnik na polu. Wykorzystując Umiejętność Badania Naukowe, możesz odwrócić kolejność kostek nieudanego Testu, jeśli zapewni ci to sukces.', 'Bonus z Inteligencji', 'Badania Naukowe', 'WFRP4e Core' )
, ( 'Mówca', 'Jesteś umiejętnym oratorem i wiesz, jak urabiać tłumy. Poniższa tabela wskazuje, ile osób ulegnie twojemu wpływowi, gdy wykonasz Test Charyzmy (patrz strona 119) podczas przemawiania.', 'Bonus z Ogłady', NULL, 'WFRP4e Core' )
, ( 'Musztra', 'Zostałeś wyszkolony w walce obok innych żołnierzy. Jeśli przeciwnik sprawi, że stracisz Przewagę, a znajdujesz się obok innej, aktywnej postaci z Talentem Musztra, możesz zachować 1 Przewagę za każde wykupienie tego Talentu.', 'Bonus z Walki Wręcz', 'Broń Biała, kiedy jesteś w pobliżu sojuszniczej postaci z tym Talentem', 'WFRP4e Core' );

INSERT INTO talents (name, description, max_rank, tests, source)
VALUES ( 'Naśladowca', 'Potrafisz naśladować akcenty i głosy innych osób. Pozwala ci to na bezbłędne odtworzenie lokalnego akcentu po godzinie przebywania z jego rodzimymi użytkownikami. Zdałeś Wymagający (+0) Test Percepcji, by zapamiętać i odtworzyć głos konkretnej osoby, o ile słyszałeś ją przez przynajmniej 10 minut.', 'Bonus z Inicjatywy', 'Występy (Aktorstwo), gdy udajesz czyjś głos', 'WFRP4e Core' )
, ( 'Niegodny Uwagi', 'Wyglądasz przeciętnie i łatwo giniesz w tłumie. Dopóki nie robisz niczego wyjątkowego, inni raczej ciebie nie zauważą ani nie zapamiętają. Przeciwnicy automatycznie zignorują cię podczas określania kolejności celów w walce, dopóki sam ich nie zaatakujesz lub nie zaczniesz rzucać czarów.', 'Bonus z Ogłady', 'Skradanie (Miasto)', 'WFRP4e Core' )
, ( 'Nienawiść (Grupa)', 'Coś w Starym Świecie powoduje twoją nienawiść, jak to opisano na stronie 190\. Każde wykupienie tego Talentu to jej nowy obiekt, a przykładowe grupy to: Banici, Czarownice, Ożywieńcy, Potwory, Sigmaryci, Zielonoskórzy, Zwierzoludzie.', 'Bonus z Siły Woli', 'Siła Woli (Opieranie się Grupie)', 'WFRP4e Core' )
, ( 'Nieubłagany', 'Trzeba nie lada wysiłku, by cię wykończyć. Twojej postaci nie dotyczy utrata żywotności, spowodowana Stanem Krwawienie. Każde wykupienie tego Talentu powoduje, że możesz zignorować jedną ranę spowodowaną przez ten Stan.', 'Bonus z Wytrzymałości', NULL, 'WFRP4e Core' )
, ( 'Nieugięty', 'Ruszasz do walki z niezłomną, ponurą determinacją. Podczas Szarży dodaj liczbę wykupień tego Talentu do Bonusu z Siły.', 'Bonus z Siły', NULL, 'WFRP4e Core' )
, ( 'Nieustępliwy', 'Kiedy skupisz się na celu, nie sposób cię powstrzymać przed dotarciem do niego. Jeśli wykorzystujesz Przewagę podczas Odwrotu, możesz zachować jej tyle, ile razy masz wykupiony ten Talent. Co więcej, możesz wykorzystać Przewagi do Odwrotu, nawet jeśli masz ich mniej niż przeciwnik.', 'Bonus ze Zwinności', NULL, 'WFRP4e Core' )
, ( 'Nieustraszony (Typ Wroga)', 'Jesteś tak odważny lub szalony, że strach przed pewnymi istotami jest dla ciebie wspomnieniem. Za pomocą jednego Przeciętnego (+20) Testu Opanowania możesz sprawdzić, że nie dotyczą cię efekty Zastraszania, Strachu i Grozy, powodowane przez określoną grupę wrogów. Oto typowe przykłady takich wrogów: Banici, Czarownice, Strażnicy, Wampiry, Zielonoskórzy, Zwierzoludzie.', 'Bonus z Siły Woli', 'Opanowanie przeciwko wrogiemu Zastraszaniu oraz Testom Strachu i Grozy', 'WFRP4e Core' )
, ( 'Niewzruszony', 'Jesteś twardym wiarusem, który przetrwał niejedną salwę z broni czarnoprochowej. Musisz wykonać Test Opanowania, by oprzeć się Stanowi Panika, dopiero kiedy zostaniesz zraniony przez broń prochową, a nie wtedy, gdy zostaniesz z niej tylko ostrzelany.', 'Bonus z Siły Woli', 'Opanowanie przeciwko panice prochowej', 'WFRP4e Core' )
, ( 'Niezwykle Odporny', 'Twoja początkowa Wytrzymałość zostaje na stałe podniesiona o +5, co nie liczy się do sumy twoich Rozwinięć.', '1', NULL, 'WFRP4e Core' )
, ( 'Nos do Kłopotów', 'Wiesz, jak wpaść w kłopoty i - jeszcze lepiej - jak się z nich wyłgać. Możesz wykonać Test Intuicji, by zorientować się, kto potencjalnie może sprawiać problemy. Test ten przysługuje ci, nawet gdyby nie wolno ci było go wykonać (z powodu działania innych Talentów, czarów itp.). Test ów będzie zapewne Przeciwstawny, jeśli napastnicy się kryją. MG może go wykonać w ukryciu za ciebie, byś nie wiedział, czy zakończy się on porażką, czy sukcesem. Jeśli zauważony przez ciebie wichrzyciel rozpocznie walkę, nie działa na ciebie Stan Zaskoczenie.', 'Bonus z Inicjatywy', 'Każdy, by wypatrzeć potencjalne problemy', 'WFRP4e Core' )
, ( 'Numizmatyka', 'Masz dobre oko do monet i potrafisz ocenić ich wagę oraz wartość od pierwszego wejrzenia. Test Wyceny monet i kamieni szlachetnych przysługuje ci jako Akcja Darmowa i automatycznie odrzucasz 1 nieudaną kostkę.', 'Bonus z Inteligencji', 'Wycena monet i klejnotów', 'WFRP4e Core' ), ( 'Obieżyświat', 'Dużo podróżowałeś i znasz zwyczaje wielu ludów Starego Świata. Dodaj PS równe liczbie wykupień tego Talentu do udanych Testów Wiedzy (Lokalnej) odnoszących się do terenów poza twoim rodzinnym księstwem lub prowincją.', 'Bonus z Inteligencji', 'Wiedza (Lokalna) poza rodzinnym terenem', 'WFRP4e Core' )
, ( 'Oburęczność', 'Twoja słabsza ręka jest sprawniejsza niż u innych ludzi. Być może zostałeś tego nauczony, być może to wrodzona cecha, ale efekt jest ten sam: modyfikator do Testów wykonywanych „drugą” ręką zostaje zmniejszony z -20 do -10\. Jeśli wykupisz ten Talent drugi raz, modyfikatora nie stosuje się do twojej postaci.', '2', NULL, 'WFRP4e Core' )
, ( 'Odporność na Magię', 'Jesteś uodporniony na zaklęcia. Poziom Sukcesów czarów rzucanych na ciebie jest obniżony o 2 za każde wykupienie tego Talentu. Poziom Sukcesów jest obniżany tylko od najwyższej Odporności na Magię w obszarze oddziaływania czaru. Co więcej, nie możesz wykupić Talentów: Magia Tajemna, Błogosławieństwo, Inwokacja, Magia Prosta i Czarownica.', 'Bonus z Wytrzymałości', NULL, 'WFRP4e Core' )
, ( 'Odporność Psychiczna', 'Jesteś uosobieniem determinacji i niezłomności. Dodaj tyle Punktów Determinacji do ich maksymalnej puli, ile razy wykupiłeś ten Talent.', 'Bonus z Siły Woli', NULL, 'WFRP4e Core' )
, ( 'Odporny na (Zagrożenie)', 'Twoja wielka wytrwałość pozwala ci poradzić sobie z niebezpieczeństwem. Automatycznie zdajesz pierwszy Test opierania się przeciwko konkretnemu typowi zagrożenia na danej sesji. Znane są Odporności na Choroby, Magię, Mutacje czy Trucizny. Jeśli w Teście ważne są Poziomy Sukcesu, to za ich liczbę przyjmujesz Bonus z Wytrzymałości.', 'Bonus z Wytrzymałości', 'Wszystkie, gdy opierasz się powiązanemu zagrożeniu', 'WFRP4e Core' )
, ( 'Odwrócenie Szans', 'Wiesz, jak wykorzystać potknięcie przeciwnika i obrócić je na swoją korzyść. Kiedy twój przeciwnik uzyska Zdumiewającą Porażkę w Teście Przeciwstawnym przeciwko tobie, otrzymujesz dodatkowo +1 Przewagę.', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Ogłuszenie', 'Umiarkowany lub silny cios w głowę potrafi powalić każdego. Gdy trafisz przeciwnika bronią mającą Cechę Ogłuszająca lub w walce bez broni, używając Umiejętności Broń Biała (Bijatyka), cel musisz zdać Test Odporności, inaczej otrzyma Stan Oszołomienie.', 'Bonus z Siły', 'Broń Biała (Bijatyka) lub broń Ogłuszająca', 'WFRP4e Core' )
, ( 'Oko Łowcy', 'Jesteś dobrym myśliwym i znasz najlepsze sposoby szukania zwierzyny. Kiedy podróżujesz po bogatych w nią ziemiach, jesteś automatycznie w stanie wyżywić siebie i tylu towarzyszy, ile razy wykupiłeś ten Talent, jeśli tylko masz czas, by zapolować, oraz odpowiednie wyposażenie. Więcej pożywienia możesz zapewnić, wykorzystując zasady znajdujące się na stronie 129.', 'Bonus z Inicjatywy', 'Dowolny wiążący się z Tropieniem lub polowaniem na zwierzynę', 'WFRP4e Core' )
, ( 'Opanowany', 'Twoja początkowa Siła Woli zwiększa się na stałe o +5, co nie liczy się do sumy Rozwinięć twojej postaci.', '1', NULL, 'WFRP4e Core' )
, ( 'Pancerz Wiary', 'Twoja głęboka wiara chroni cię przed złem. Otrzymujesz Punkty Pancerza na wszystkich lokacjach w wysokości równej liczbie wykupień tego Talentu, kiedy walczysz przeciwko wrogom twojej wiary lub istotom będącym ucieleśnieniem Chaosu.', 'Bonus z Ogłady', NULL, 'WFRP4e Core' )
, ( 'Pełen Werwy', 'Twój początkowy Bonus z Wytrzymałości wzrasta o +1 przy wyliczaniu początkowej Żywotności.', '1', NULL, 'WFRP4e Core' )
, ( 'Percepcja Magiczna', 'Potrafisz dostrzegać zmienne Wiatry Magii, które dmą od Bram Chaosu na biegunach świata. Dzięki temu Talentowi posiadasz zdolność postrzegania magii (patrz strona 233).', 'Bonus z Inicjatywy', 'Każdy Test dotyczący wykrywania Wiatrów Magii', 'WFRP4e Core' )
, ( 'Piekielnie Szybki', 'Twoja początkowa Zwinność zostaje na stałe podniesiona o +5, co nie wlicza się do sumy twoich Rozwinięć.', '1', NULL, 'WFRP4e Core' )
, ( 'Piorunujące Uderzenie', 'Pęd twojej Szarży zwala wrogów z nóg. Gdy trafisz przeciwnika podczas Szarży, cel musi wykonać Test Wytrzymałości. Porażka oznacza, że otrzymuje Stan Powalenie.', 'Bonus z Siły', NULL, 'WFRP4e Core' )
, ( 'Podstępny', 'Jesteś urodzonym oszustem i potrafisz mamić innych bez mrugnięcia okiem. Kiedy kłamiesz lub oszukujesz, możesz odwrócić kolejność kostek nieudanego Testu Charyzmy lub Zwinnych Palców, jeśli nowy wynik da ci sukces.', 'Bonus z Ogłady', 'Charyzma lub Zwinne Palce podczas oszustwa', 'WFRP4e Core' )
, ( 'Poliglota', 'Masz wyjątkowy talent do języków obcych. Test Inteligencji pozwala ci nauczyć się podstaw nowego języka w kilka dni, a nie tygodni.', 'Bonus z Inteligencji', 'Testy Inteligencji przy nauce języka', 'WFRP4e Core' )
, ( 'Porywająca Gorliwość', 'Swoim zapałem i żarliwością potrafisz natchnąć tłumy. Kiedy przemawiasz lub modlisz się przed bitwą, twoi słuchacze zyskują premię +10 do Testów Opanowania przeciwko Strachowi i Grozie na czas najbliższej potyczki.', 'Bonus z Ogłady', 'Występy (Przemowy) lub Modlitwa', 'WFRP4e Core' )
, ( 'Posłuch u Zwierząt', 'Dzikie zwierzęta dobrze się czują w twojej obecności i często są posłuszne twoim poleceniom. Wszystkie istoty o Cesze Zwierzę, których nie wytresowano, by były agresywne, uspokajają się w twojej obecności, chyba że mają powód, by zachować czujność. Ból, napaść czy naturalna wysoka agresja lub opieka nad młodymi mogą sprawić, że zwierzę nie podda się działaniu tego Talentu.', 'Bonus z Siły Woli', 'Oswajanie', 'WFRP4e Core' )
, ( 'Precyzyjne Inkantowanie', 'Instynktownie pojmujesz język magiczny i bez omyłki jesteś w stanie wypowiadać skomplikowane formuły. Jeśli rzucisz dublet podczas udanego Testu Języka (Magicznego), nie dochodzi do manifestacji.', 'Bonus z Inicjatywy', 'Język (Magiczny) podczas rzucania czaru', 'WFRP4e Core' )
, ( 'Prosto Między Oczy', 'Twoje strzały i bełty trafiają w czułe punkty. Kiedy uzyskasz Trafienie Krytyczne w walce dystansowej, zadajesz dodatkowo tylu punktów obrażeń, ile wynosi poziom tego Talentu.', 'Bonus ze Zręczności', NULL, 'WFRP4e Core' )
, ( 'Przestępca', 'Obracasz się w półświatku i znasz zasady rządzące przestępczym podziemiem. Członkowie grup przestępczych rozpoznają cię jako swojego i traktują ze względną przychylnością, dopóki ich nie zdradzisz.', '1', 'Plotkowanie i Przekupstwo wśród przestępców', 'WFRP4e Core' )
, ( 'Przeczucie Zagrożenia', 'Coś w głębi duszy ostrzega cię przed niebezpieczeństwem. MG wykonuje za ciebie w tajemnicy Test Intuicji, gdy twojej postaci grozi nagłe niebezpieczeństwo lub zasadzka. Udany test pozwala uniknąć Stanu Zaskoczenie.', '1', 'Intuicja, by uniknąć zasadzki', 'WFRP4e Core' )
, ( 'Przekonujący', 'Twoje argumenty trafiają do rozsądku innych. Kiedy wykonujesz Test Przekonywania lub Charyzmy, dodaj tylu PS, ile wynosi poziom tego Talentu.', 'Bonus z Ogłady', 'Charyzma', 'WFRP4e Core' )
, ( 'Przyjaciel Zwierząt', 'Zwierzęta wyczuwają twoje dobre intencje. Każde nietresowane zwierzę z natury traktuje cię przyjaźnie i nie zaatakuje cię, dopóki go nie sprowokujesz.', 'Bonus z Siły Woli', 'Oswajanie', 'WFRP4e Core' )
, ( 'Przyrządzanie Mikstur', 'Znasz sekrety warzenia mikstur, eliksirów i maści leczniczych lub magicznych. Zmniejszasz czas potrzebny na przygotowanie mikstury o połowę za każdy poziom tego Talentu.', 'Bonus ze Zręczności', 'Rzemiosło (Aptekarstwo / Alchemia)', 'WFRP4e Core' )
, ( 'Pustelnik', 'Potrafisz żyć w samotności z dala od cywilizacji. Kiedy przebywasz z dala od miast i wsi, nie odczuwasz samotności ani braku kontaktu z ludźmi, a Testy Opanowania przeciwko izolacji zdajesz automatycznie.', '1', NULL, 'WFRP4e Core' );
INSERT INTO talents (name, description, max_rank, tests, source)
VALUES ( 'Riposta', 'Potrafisz błyskawicznie zamienić udaną obronę w zabójczy kontratak. Kiedy z powodzeniem sparujesz atak bronią mającą Cechę Parująca, możesz natychmiast zadać przeciwnikowi 1 darmowy cios tą samą bronią w ramach Akcji Darmowej.', 'Bonus z Walki Wręcz', 'Broń Biała (Parująca) podczas Riposty', 'WFRP4e Core' )
, ( 'Rozbrajanie', 'Wiesz, jak wybić broń z dłoni przeciwnika. Kiedy wygrasz Przeciwstawny Test Broni Białej podczas obrony lub ataku, możesz zrezygnować z zadania obrażeń lub zdobycia Przewagi, by zmusić wroga do rzucenia trzymanej broni na ziemię. Przeciwnik może wykonać Test Zwinności, by spróbować ją zatrzymać.', 'Bonus z Walki Wręcz', 'Broń Biała (Parująca) przy Rozbrajaniu', 'WFRP4e Core' )
, ( 'Rozmyślne Spaczenie', 'Świadomie otwierasz swój umysł i ciało na wpakowujące wpływ Zepsucia, aby zyskać potęgę. Za każdym razem, gdy dobrowolnie przyjmujesz Punkty Zepsucia, możesz dodać ich liczbę jako premię do swojego następnego Testu Cechy lub Umiejętności.', 'Bonus z Siły Woli', NULL, 'WFRP4e Core' )
, ( 'Rozpoznanie Artefaktu', 'Masz oko do niezwykłych i magicznych przedmiotów. Udany Test Wyceny lub Badań Naukowych pozwala ci zidentyfikować magiczne właściwości przedmiotu, jego historię oraz ewentualne zagrożenia z nim związane.', 'Bonus z Inteligencji', 'Wycena lub Badania Naukowe', 'WFRP4e Core' )
, ( 'Rozproszenie Uwagi', 'Potrafisz odwrócić uwagę wroga w krytycznym momencie. Podczas swojej Tury możesz wykonać Akcję Darmową, by odwrócić uwagę jednego przeciwnika. Wykonaj Przeciwstawny Test Zwinnych Palców przeciwko Percepcji celu. Sukces oznacza, że cel traci 1 Przewagę.', 'Bonus z Inicjatywy', 'Zwinne Palce', 'WFRP4e Core' )
, ( 'Ruchliwe Dłonie', 'Manipulujesz dłońmi z zaskakującą zręcznością. Gapiom i przypadkowym obserwatorom nie przysługuje bierny Test Percepcji, gdy wykorzystujesz Umiejętność Zwinne Palce, chyba że żywią oni wobec ciebie podejrzenia i obserwują twoje ruchy. Testy Broni Białej (Bijatyki) wykonywane, by dotknąć przeciwnika, wykonujesz z premią +10 x liczba wykupień tego Talentu.', 'Bonus ze Zręczności', 'Zwinne Palce, Broń Biała (Bijatyka)', 'WFRP4e Core' )
, ( 'Rybak', 'Jesteś obrotnym rybakiem i wiesz, jak zapełnić sieci. Jeżeli masz dostęp do odpowiednio dużego zbiornika wodnego, jesteś w stanie wyżywić siebie oraz tyle osób, ile razy wykupiłeś ten Talent, jeśli poświęcisz godzinę dziennie na wędkowanie. Liczbę złowionych ryb możesz zwiększyć, stosując zasady zbieractwa (patrz strona 129).', 'Bonus z Inicjatywy', 'Dowolne wiążące się z rybołówstwem', 'WFRP4e Core' )
, ( 'Silne Nogi', 'Masz silne nogi, dzięki którym jesteś w stanie wykonywać nieprawdopodobnie dalekie skoki. Dodaj liczbę wykupień tego Talentu do PS Testów Atletyki wiążących się ze skakaniem (patrz strona 166).', 'Bonus z Siły', 'Atletyka podczas skakania', 'WFRP4e Core' )
, ( 'Silny Cios', 'Wiesz, jak komuś przywalić! Posługując się bronią do Walki Wręcz, zadajesz obrażenia powiększone o tyle, ile razy masz wykupiony ten Talent.', 'Bonus z Siły', NULL, 'WFRP4e Core' )
, ( 'Skrócenie Dystansu', 'Wiesz, jak przyciągnąć do siebie przeciwnika, i nie dotyczą cię modyfikatory za walkę z wrogiem, który ma broń dłuższą niż Twoja. Jeśli używasz opcjonalnych zasad walki kontaktowej (patrz strona 297), otrzymujesz premię +10 do trafienia przeciwnika.', 'Bonus ze Zręczności', 'Podczas wchodzenia w zasięg broni przeciwnika i w walce kontaktowej', 'WFRP4e Core' )
, ( 'Słuch Absolutny', 'Twój słuch jest niezwykle czuły i idealnie dostrojony do tonów i dźwięków. Otrzymujesz automatyczny sukces w rozpoznawaniu fałszywych nut oraz premię +20 do Testów Percepcji opartych na słuchu i Testach Muzyki.', '1', 'Percepcja (Słuch) oraz Muzyka', 'WFRP4e Core' ), ( 'Snajper', 'Brak kąta i duża odległość nie stanowią dla ciebie przeszkody przy strzale. Nie dotyczy cię kara -10 do Testów Broni Zasięgowej za strzelanie na Daleki Zasięg.', 'Bonus ze Zręczności', 'Broń Zasięgowa na Daleki Zasięg', 'WFRP4e Core' )
, ( 'Straszny', 'Twój wygląd lub zachowanie budzi przerażenie. Otrzymujesz Cechę Stworzenia Groza (1). Jeśli cel nie zda Testu Opanowania, ucieka w Panice.', '1', NULL, 'WFRP4e Core' )
, ( 'Strzał Przebijający', 'Twoje pociski dziurawią pancerz wroga. Ataki bronią zasięgową ignorują 1 Punkt Pancerza celu za każdy poziom tego Talentu.', 'Bonus ze Zręczności', 'Broń Zasięgowa', 'WFRP4e Core' )
, ( 'Strzał w Dziesiątkę', 'Twoja celność graniczy z cudem. Kiedy uzyskasz Krytyczny Sukces w Teście Broni Zasięgowej, możesz zamienić lokację trafienia na Głowę bez modyfikacji rzutu.', 'Bonus ze Zręczności', 'Broń Zasięgowa', 'WFRP4e Core' )
, ( 'Strzelec Wyborowy', 'Twoja początkowa Umiejętność Strzelecka wzrasta na stałe o +5, co nie liczy się do sumy Rozwinięć postaci.', '1', NULL, 'WFRP4e Core' )
, ( 'Szczęście', 'Los ci sprzyja bardziej niż innym. Zwiększasz swoją maksymalną pulę Punktów Szczęścia o +1 za każde wykupienie tego Talentu.', 'Bonus z Przeznaczenia', NULL, 'WFRP4e Core' )
, ( 'Szczur Kanałowy', 'Odporny na smród i brud podziemi. Zdajesz automatycznie Testy Odporności na choroby przenoszone przez brud i ścieki oraz nie otrzymujesz kar za poruszanie się w ciasnych kanałach.', 'Bonus z Wytrzymałości', 'Odporność przeciw chorobom ściekowym', 'WFRP4e Core' )
, ( 'Szósty Zmysł', 'Wyczuwasz niebezpieczeństwo, zanim się urzeczywistni. MG może ostrzec cię w tajemnicy o grożącym niebezpieczeństwie lub zasadzce, dając ci czas na reakcję i zapobiegając Stanowi Zaskoczenie.', 'Bonus z Inicjatywy', 'Intuicja, by uniknąć Zaskoczenia', 'WFRP4e Core' )
, ( 'Szuler', 'Wiesz, jak oszukiwać w grach hazardowych. Kiedy grasz w karty lub kości, możesz potajemnie zmodyfikować wynik swojego rzutu o +/- 10.', 'Bonus z Inteligencji', 'Hazard', 'WFRP4e Core' )
,( 'Szuler Kościany', 'Mistrz gry w kości. Przypadkowe lub dociążone kości nie mają przed tobą tajemnic. Możesz przerzucić jeden nieudany rzut w Hazardzie podczas gry w kości.', 'Bonus z Inteligencji', 'Hazard (Kości)', 'WFRP4e Core' )
, ( 'Szybki Refleks', 'Twoja początkowa Zwinność wzrasta na stałe o +5, co nie liczy się do sumy Rozwinięć postaci.', '1', NULL, 'WFRP4e Core' )
, ( 'Szybkie Czytanie', 'Czytasz i przyswajasz tekst w zdumiewającym tempie. Skracasz czas potrzebny na przeczytanie książki lub dokumentu o połowę za każdy poziom tego Talentu.', 'Bonus z Inteligencji', 'Badania Naukowe', 'WFRP4e Core' )
, ( 'Szybkie Przeładowanie', 'Potrafisz z łatwością przeładowywać bronie strzeleckie. Dodaj PS równe liczbie wykupień tego Talentu do Testów przeładowania broni dystansowej.', 'Bonus ze Zręczności', 'Testy przeładowania broni dystansowej', 'WFRP4e Core' )
, ( 'Szybkobiegacz', 'Żwawo przebierasz nogami. Podczas Biegu twoja Szybkość jest traktowana, jakby była o 1 wyższa.', 'Bonus z Siły', 'Atletyka podczas Biegu', 'WFRP4e Core' )
, ( 'Szycha', 'Pomimo powiązań z półświatkiem otacza cię aura szacunku. Twojej postaci nie dotyczy utrata Statusu spowodowana przez Talent Przestępca.', '1', NULL, 'WFRP4e Core' )
, ( 'Świetny Pływak', 'W wodzie czujesz się jak ryba. Twoja Szybkość podczas pływania nie jest zmniejszana o połowę, a Testy Pływania w trudnych warunkach wykonujesz z premią +10.', 'Bonus z Siły', 'Pływanie', 'WFRP4e Core' )
, ( 'Talent Artystyczny', 'Posiadasz wrodzone wyczucie estetyki i formy. Dodaj PS równe liczbie wykupień tego Talentu do udanych Testów Umiejętności Sztuka.', 'Bonus ze Zręczności', 'Sztuka', 'WFRP4e Core' )
, ( 'Tarczownik', 'Doskonale zasłaniasz się tarczą. Kiedy używasz tarczy do obrony przed atakami dystansowymi, zasłania ona także sąsiednie lokacje pancerza, a Punkty Pancerza tarczy dodają się do twojego pancerza na tych lokacjach.', 'Bonus z Walki Wręcz', 'Broń Biała (Parująca) przy użyciu tarczy', 'WFRP4e Core' )
, ( 'Towarzyski', 'Łatwo nawiązujesz kontakty i zjednujesz sobie ludzi. Możesz odwrócić kolejność kostek nieudanego Testu Charyzmy, jeśli nowy wynik zapewni ci sukces.', 'Bonus z Ogłady', 'Charyzma', 'WFRP4e Core' )
, ( 'Tragarz', 'Jesteś przyzwyczajony do dźwigania ciężkich ładunków. Twój maksymalny udźwig w punktach Obciążenia wzrasta o +2 za każdy poziom tego Talentu.', 'Bonus z Siły', NULL, 'WFRP4e Core' )
, ( 'Traper', 'Specjalista od tropienia i chwytania zwierzyny. Kiedy zastawiasz wnyki lub pułapki w dziczy, ich stopień trudności do wykrycia i rozbrojenia wzrasta o +10 za każdy poziom tego Talentu.', 'Bonus z Inicjatywy', 'Zastawianie Pułapek w dziczy', 'WFRP4e Core' )
, ( 'Twardziel', 'Jesteś wyjątkowo odporny na ciosy i bóle. Twoja maksymalna Żywotność wzrasta o +1 za każde wykupienie tego Talentu.', 'Bonus z Wytrzymałości', NULL, 'WFRP4e Core' )
, ( 'Ulicznik', 'Znasz miejskie zaułki i tajemnice ulicy. Odwracasz kolejność kości w nieudanych Testach Skradania (Miasto), jeśli nowy wynik da ci sukces.', 'Bonus z Inicjatywy', 'Skradanie (Miasto)', 'WFRP4e Core' )
, ( 'Urodzony w Siodle', 'W siodle czujesz się pewniej niż na własnych nogach. Nie musisz wykonywać Testów Jeździectwa przy wykonywaniu podstawowych manewrów w walce konnej, a w trudnych próbach dodajesz +10 do Testu.', 'Bonus ze Zwinności', 'Jeździectwo (Konie)', 'WFRP4e Core' )
, ( 'Urodzony Wojownik', 'Twoja początkowa Walka Wręcz wzrasta na stałe o +5, co nie liczy się do sumy Rozwinięć postaci.', '1', NULL, 'WFRP4e Core' )
, ( 'Waleczne Serce', 'Twoja niezłomna wola pozwala ci opierać się strachowi i panice na polu bitwy. Dodaj PS równe poziomowi tego Talentu do udanych Testów Opanowania przeciwko Strachowi i Grozie.', 'Bonus z Siły Woli', 'Opanowanie przeciwko Strachowi i Grozie', 'WFRP4e Core' )
, ( 'Walka w Ciasnocie', 'Przyzwyczajony do walki w ciasnych korytarzach, tunelach i tłumie. Nie otrzymujesz kar do walki bronią w ciasnych pomieszczeniach ani w zwarciu.', 'Bonus ze Zwinności', 'Broń Biała w ciasnych miejscach', 'WFRP4e Core' )
, ( 'Widzenie w Ciemności', 'Widzisz bez przeszkód w słabym świetle i ciemnościach na odległość do 20 metrów, jakby panował półmrok.', 'Bonus z Inicjatywy', NULL, 'WFRP4e Core' )
, ( 'Wieża Pamięci', 'Twój umysł jest uporządkowany niczym biblioteka. Pamiętasz bezbłędnie szczegóły, imiona, daty i fakty, które raz usłyszałeś lub przeczytałeś. Testy pamięci zdajesz automatycznie.', 'Bonus z Inteligencji', 'Testy pamięci i odtwarzania faktów', 'WFRP4e Core' )
, ( 'Włóczykij', 'Czujesz się swobodnie na wiejskich szlakach i w dziczy. Odwracasz kolejność kostek w nieudanych Testach Skradania (Wieś), jeśli nowy wynik da ci sukces.', 'Bonus z Inicjatywy', 'Skradanie (Wieś)', 'WFRP4e Core' )
, ( 'Władcza Postura', 'Twój głos i aparycja budzą natychmiastowy posłuch. Osoby o niższym Statusie wykonują twoje polecenia bez zbędnych pytań, chyba że są one wyraźnie niebezpieczne lub szkodliwe.', 'Bonus z Ogłady', 'Dowodzenie', 'WFRP4e Core' )
, ( 'Wódz', 'Jesteś urodzonym dowódcą na polu bitwy. Zwiększasz zasięg wpływu swojego Dowodzenia oraz wsparcia morale o połowę za każdy poziom tego Talentu.', 'Bonus z Ogłady', 'Dowodzenie', 'WFRP4e Core' )
, ( 'Wróżba Losu', 'Mędrcy lub kapłani przepowiedzieli ci słowa określające twoją śmierć. Kiedy grozi ci śmiertelne niebezpieczeństwo zgodne z przepowiednią, zyskujesz dodatkowy Punkt Przeznaczenia na czas trwania tej sceny.', '1', NULL, 'WFRP4e Core' )
, ( 'Wściekły Atak', 'Rzucasz się do szaleńczego natarcia. Kiedy wykonujesz Wściekły Atak w walce wręcz, otrzymujesz premię +10 do trafienia oraz +1 do Obrażeń za każdy poziom tego Talentu.', 'Bonus z Walki Wręcz', 'Broń Biała przy Wściekłym Ataku', 'WFRP4e Core' )
, ( 'Wycofanie', 'Potrafisz sprawnie zerwać kontakt bojowy. Kiedy wykonujesz manewr Odwrotu w walce, nie musisz wydawać Przewagi, by bezpiecznie wycofać się z zasięgu wroga.', 'Bonus ze Zwinności', 'Unik przy Odwrocie', 'WFRP4e Core' )
, ( 'Wyczulony Zmysł (Zmysł)', 'Jeden z twoich zmysłów (Wzrok, Słuch, Węch, Dotyk lub Smak) jest niezwykle wyostrzony. Otrzymujesz premię +10 do wszystkich Testów Percepcji wykorzystujących ten zmysł.', 'Bonus z Inicjatywy', 'Percepcja dla wybranego zmysłu', 'WFRP4e Core' )
, ( 'Wyczucie Kierunku', 'Zawsze wiesz, gdzie jest północ, i rzadko tracisz orientację w terenie. Zyskujesz premię +10 do wszystkich Testów Nawigacji.', 'Bonus z Inicjatywy', 'Nawigacja', 'WFRP4e Core' )
, ( 'Wykrywanie Magii', 'Potrafisz wyczuć obecność Wiatrów Magii w innych. Możesz wykonać Przeciętny (+20) Test Intuicji, gdy spotykasz się z osobą władającą czarami. Jeśli się on powiedzie, wyczuwasz jej zdolności. To nie wszystko, jeśli osiągniesz Zdumiewający (+6) Sukces możesz także określić najwyższą Specjalizację Splatania Magii tej osoby.', 'Bonus z Inicjatywy', 'Intuicja, by wykrywać czarodziejów', 'WFRP4e Core' )
, ( 'Wytrwały', 'Bez względu na okoliczności i powagę sytuacji ty przenigdy się nie poddajesz. Podwajasz czas opierania się przeciwnościom, zapewniany przez udany Test Odporności. Wytrzymujesz długą jazdę, wystawienie na warunki atmosferyczne, rytualne próby i tym podobne trudności.', 'Bonus z Wytrzymałości', 'Odporność, by wytrzymać trudności', 'WFRP4e Core' )
, ( 'Wytwórca (Rzemiosło)', 'Jesteś wybitnym specjalistą w wybranym Rzemiośle. Zmniejszasz czas wytwarzania przedmiotów oraz koszty materiałowe o 10% za każdy poziom tego Talentu.', 'Bonus ze Zręczności', 'Rzemiosło', 'WFRP4e Core' )
, ( 'Zabójca', 'Specjalizujesz się w uśmiercaniu potężnych wrogów. Przeciwko wrogom o Rozmiarze większym od twojego zadajesz dodatkowe obrażenia równe liczbie wykupień tego Talentu.', 'Bonus z Walki Wręcz', NULL, 'WFRP4e Core' )
, ( 'Zaatakuj i Odskocz', 'Niezwykle zwrotny w walce. Po udanym ataku w walce wręcz możesz wykonać darmowy ruch o długości równej twojej Szybkości bez prowokowania ataków okazyjnych.', 'Bonus ze Zwinności', 'Unik', 'WFRP4e Core' )
, ( 'Zbicie Broni', 'Mistrzowsko parujesz ciosy wroga. Kiedy z sukcesem sparujesz atak, zmniejszasz Przewagę napastnika o 1 za każdy poziom tego Talentu.', 'Bonus z Walki Wręcz', 'Broń Biała (Parująca)', 'WFRP4e Core' )
, ( 'Zejście z Linii', 'Wiesz, jak znaleźć się tam, gdzie nie sięga oręż wroga. Jeśli wykorzystujesz Umiejętność Unik, by zejść z linii ciosu, i wygrasz Test Przeciwstawny, możesz poruszyć się na odległość do 2 metrów i nie liczysz się jako związany walką. Przeciwnik nie może wykonać przeciwko tobie darmowych ataków.', 'Bonus ze Zwinności', 'Unik, gdy używasz tego Talentu', 'WFRP4e Core' )
, ( 'Zimna Krew', 'Zyskujesz premię +5 do początkowej wartości Siły Woli, co nie wlicza się do sumy Rozwinięć.', '1', NULL, 'WFRP4e Core' )
, ( 'Złota Rączka', 'Jesteś w stanie naprawić dosłownie wszystko, a kiedy coś reperujesz, traktujesz wszystkie niemagiczne Umiejętności Rzemiosła jako podstawowe.', 'Bonus ze Zręczności', 'Rzemiosło, by naprawić uszkodzone przedmioty', 'WFRP4e Core' )
, ( 'Zmysł Bitewny', 'Instynktownie czujesz zagrożenie na polu bitwy. Nie możesz zostać zaskoczony w walce, a w pierwszej rundzie starcia zyskujesz premię +10 do Inicjatywy.', 'Bonus z Inicjatywy', 'Intuicja / Inicjatywa', 'WFRP4e Core' )
, ( 'Zmysł Magii', 'Twoja wrażliwość na magię jest wyższa niż u innych czarodziejów. Wyczuwasz użycie magii w promieniu 100 metrów oraz zyskujesz premię +10 do Testów Percepcji Magicznej.', 'Bonus z Inicjatywy', 'Percepcja Magiczna', 'WFRP4e Core' )
, ( 'Znawca (Wiedza)', 'Jesteś chodzącą encyklopedią w wybranej dziedzinie Wiedzy. Podczas Testów wybranej Wiedzy możesz przerzucić jeden nieudany rzut na sesję.', 'Bonus z Inteligencji', 'Wybrana Umiejętność Wiedza', 'WFRP4e Core' )
, ( 'Zręczny', 'Twoja początkowa Zręczność wzrasta na stałe o +5, co nie wlicza się do sumy Rozwinięć postaci.', '1', NULL, 'WFRP4e Core' )
, ( 'Żelazna Wola', 'Twój umysł jest niezdobytą twierdzą. Zyskujesz premię +10 do Testów Opanowania i Siły Woli, gdy opierasz się czarom, magii umysłu lub wpływom Zepsucia.', 'Bonus z Siły Woli', 'Opanowanie / Siła Woli', 'WFRP4e Core' )
, ( 'Żyłka Handlowa', 'Urodzony kupiec. Zawsze wyciągasz najlepsze ceny. Przy kupnie i sprzedaży towarów uzyskujesz premię 5% na korzyść swojej postaci za każdy poziom tego Talentu.', 'Bonus z Ogłady', 'Targowanie', 'WFRP4e Core' );


-- Migration: WFRP 4e Supplemental Talents (Pod Bronią, Wiatry Magii, Niezbędniki)
INSERT INTO talents (name, description, max_rank, tests, source) VALUES
-- ========================================================================= -- POD BRONIĄ (Up in Arms) - Nowe oraz Zaktualizowane Talenty -- =========================================================================
( 'Dowódca Załogi', 'Umiesz zarządzać załogą maszyn oblężniczych i artylerii. Możesz wykonać Wymagający (+0) Test Dowodzenia, by pomóc załodze obsługującej broń z Wadą Załoga, znajdującej się w zasięgu twojego głosu. Jeśli ci się uda, członkowie załogi mogą przy oddawaniu strzału wykorzystać twoją odpowiednią Umiejętność Broń Zasięgowa.', 'Bonus z Inicjatywy', 'Broń Zasięgowa, kiedy strzelasz z broni z Wadą Załoga', 'Pod Bronią' )
, ( 'Chodu!', 'Kiedy na szali znajduje się twoje życie, potrafisz niezwykle sprawnie przebierać nogami. Podczas Ucieczki albo kiedy jesteś ściganym podczas pościgu, twoja Szybkość jest traktowana, jakby była o 1 wyższa.', 'Bonus ze Zwinności', 'Atletyka, gdy Uciekasz albo kiedy jesteś ściganym podczas pościgu', 'Pod Bronią' )
, ( 'Morderczy Atak', 'Wiesz dobrze, gdzie uderzyć, by wyrządzić jak najwięcej krzywdy. Kiedy rzucasz w Tabeli Ran Krytycznych, rzuć dwa razy i wybierz jeden z wyników.', '1', NULL, 'Pod Bronią' )
, ( 'Musztra', 'Zostałeś wyszkolony w walce obok innych żołnierzy. Postać z Talentem Musztra jest traktowana jak dwóch walczących, gdy stoi obok sojusznika z tym Talentem.', 'Bonus z Walki Wręcz', 'Broń Biała, kiedy jesteś w pobliżu sojuszniczej postaci z tym Talentem', 'Pod Bronią' )
, ( 'Szybkie Przeładowanie', 'Potrafisz z łatwością przeładowywać bronie strzeleckie. Dodaj PS równe liczbie wykupień tego Talentu do każdego Testu Wydłużonego związanego z przeładowaniem broni zasięgowej. Przeładowanie broni zasięgowej podczas walki jest traktowane jako Akcja Ocena Sytuacji. Otrzymujesz dodatkowy punkt Przewagi, kiedy wykonujesz ten Test Oceny Sytuacji.', 'Bonus ze Zręczności', NULL, 'Pod Bronią' )
, ( 'Zbicie Broni', 'Zostałeś wyszkolony w zadawaniu krótkich i gwałtownych uderzeń w oręż przeciwnika, dzięki czemu możesz sam zaatakować lub powstrzymać nadchodzący cios. W ramach swojej Akcji możesz zadeklarować Zbicie Broni przed rzutem. Wykonaj Test Broni Białej, a jeśli się powiedzie, Pula Przewagi Przeciwników traci 1 Przewagę oraz kolejną, jeżeli osiągnąłeś Zdumiewający Sukces (6 PS lub więcej). Ten Test nie jest Testem Przeciwstawnym.', 'Bonus z Walki Wręcz', 'Broń Biała, by zbić broń', 'Pod Bronią' ),
-- ========================================================================= -- WIATRY MAGII (Winds of Magic) -- =========================================================================
( 'Magiczny Pomocnik', 'Ten Talent może być posiadany jedynie przez Chowańce Mocy. Żadna inna Rasa postaci nie może się go nauczyć. Chowaniec może pomagać czarodziejowi, który go stworzył, w Testach Umiejętności Splatanie Magii, Wiedza (Magia) lub Język (Magiczny). Może również pomagać w Testach Umiejętności Badania Naukowe, zakładając, że dotyczą one magicznych wynalazków lub odkryć. Chowaniec zapewnia premię +20 do tych Testów zamiast normalnego +10 (patrz WFRP, strona 155).', '1', NULL, 'Wiatry Magii' )
, ( 'Dostrojony do (Wiatr)', 'Jesteś dostrojony do jednego z Wiatrów Magii. Wszyscy, którzy mają Percepcję Magiczną, dostrzegają postać Wiatru oplatającą twoje ciało. Każde skuteczne rzucenie zaklęcia z Tradycji związanej z danym Wiatrem Magii w odległości 8 metrów od ciebie zyskuje +1 PS. Ten bonus nie rośnie niezależnie od tego, ilu Dostrojonych do (Wiatru) jest w pobliżu rzucającego zaklęcie. Co więcej, otrzymujesz dodatkowe korzyści w zależności od tego, do jakiego Wiatru Magii jesteś dostrojony.', '1', 'Patrz opis', 'Wiatry Magii' ),
-- ========================================================================= -- WRÓG W CIENIACH - NIEZBĘDNIK (Enemy in Shadows Companion) -- =========================================================================
( 'Nasycenie Magią', 'Wszystkie zaklęcia rzucane w promieniu (Bonus z Siły Woli) metrów od Ciebie otrzymują +1 PS do Testu Rzucania Zaklęcia. Bonus może zostać przyznany tylko raz na zaklęcie, nieważne, ile postaci z tym Talentem znajduje się w pobliżu. Jeżeli w Teście Splatania Magii lub Rzucania Zaklęcia w miejscu, w którym obecny jest wpływ Tzeentcha, wypadnie cyfra 9 (na przykład przy wyniku 09, 19, 29, 90, 92 itp.), czarodziej pada ofiarą Mniejszej Manifestacji i otrzymuje Talent Nasycenie Magią do początku swojej następnej Tury. Jeśli na kostkach wypadnie 99, mag pada ofiarą Większej Manifestacji, a 1k10 metrów od niego pojawia się różowy strachulec.', '1', NULL, 'Wróg w Cieniach - Niezbędnik' );